```gitignore
# Dependencies
node_modules/

# Build output
dist/
build/

# Environment variables
.env
.env.*
!.env.example

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Runtime
pids/
*.pid
*.seed
*.pid.lock

# OS files
.DS_Store
Thumbs.db

# IDEs
.vscode/
.idea/

# TypeScript
*.tsbuildinfo

# Coverage
coverage/
.nyc_output/

# Temporary files
tmp/
temp/
.cache/

# Uploads
uploads/
public/uploads/

# Generated media
media/
storage/

# Database
*.sqlite
*.sqlite3

# Drizzle
drizzle/meta/_journal.json

# Testing
playwright-report/
test-results/

# Misc
*.tgz
*.zip

# Optional package manager files
.pnpm-store/
```
